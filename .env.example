# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Modelo de lenguaje (local con Ollama, no requiere llave) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
EMBED_MODEL=bge-m3
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.2

# --- Juez para la evaluación con DeepEval (solo lo usa `make eval`) ---
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen3:8b
# Solo si JUDGE_PROVIDER es un proveedor externo
JUDGE_API_KEY=

# --- Langfuse LOCAL (observabilidad sin salir de tu máquina) ---
# Corre en Docker (perfil "langfuse"): ./run.sh 2 lo levanta. Interfaz: http://127.0.0.1:3000
# Estas llaves son las de la API: run.sh las genera al azar la primera vez (y crea el proyecto con ellas).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Dirección del Langfuse local. Dentro de Docker la API usa http://langfuse-web:3000 automáticamente.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=asistente-laboral
# 0 desactiva las trazas (también: ./run.sh 2 --sin-langfuse)
LANGFUSE_ACTIVO=1
# Usuario para entrar a la interfaz de Langfuse; la contraseña la genera run.sh
LANGFUSE_USER_EMAIL=admin@asistente.local
LANGFUSE_USER_PASSWORD=
# Secretos internos de Langfuse (los genera run.sh; sin ellos los contenedores se niegan a arrancar)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=

# --- Costo estimado de referencia (USD por 1M tokens) ---
# El modelo corre local (costo real $0); estos precios simulan un modelo hospedado comparable.
COSTO_ENTRADA_USD_MTOK=0.10
COSTO_SALIDA_USD_MTOK=0.40

# --- API ---
# Si se define, las rutas exigen el encabezado X-API-Key
API_KEY=
MAX_PDF_MB=50
MAX_PDFS_POR_TRABAJO=10

# Modo MAX (macOS con Apple Silicon): modelo grande de Ollama; ./run.sh 3 detiene lo demás y lo usa
MODELO_MAX=qwen3.8:27b-mlx
